# Copy to `.env` and fill in values. Never commit `.env`.

# Coinbase credentials (trade-only key; withdrawals disabled)
#
# Coinbase has multiple API surfaces.
#
# 1) Coinbase Advanced Trade / CDP API keys (no passphrase; JWT/ES256)
# Used by `tools/coinbase_auth_test.py`.
COINBASE_KEY_NAME=
COINBASE_PRIVATE_KEY=
COINBASE_BROKERAGE_BASE_URL=https://api.coinbase.com
# JWT signing algorithm for your key:
# - ES256 for P-256 EC keys
# - EdDSA for Ed25519 keys
COINBASE_JWT_ALG=ES256
# Optional: default minimum timestamp for ledger sync (avoid importing old history)
COINBASE_LEDGER_MIN_TIME=2026-01-01T00:00:00Z

# 2) Coinbase Exchange API keys (legacy; HMAC + passphrase)
# Used by the current `journal/tools/sync_coinbase_fills.py`.
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Some keys require a passphrase; if yours does, set it here.
COINBASE_API_PASSPHRASE=
COINBASE_EXCHANGE_BASE_URL=https://api.exchange.coinbase.com

# Optional: set to 1 to enable extra debug logging
DEBUG=
